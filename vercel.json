{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd services/crm-frontend && npm run build",
  "outputDirectory": "services/crm-frontend/out",
  "installCommand": "cd services/crm-frontend && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://168.138.172.197/api/:path*"
    },
    {
      "source": "/webhooks/:path*",
      "destination": "http://168.138.172.197/webhooks/:path*"
    }
  ]
}
