{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "buildCommand": "cd services/crm-frontend && npm run build",
  "outputDirectory": "services/crm-frontend/out",
  "installCommand": "cd services/crm-frontend && npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://crm.goboldlabs.com/api/:path*"
    },
    {
      "source": "/webhooks/:path*",
      "destination": "https://crm.goboldlabs.com/webhooks/:path*"
    },
    {
      "source": "/:slug/review",
      "destination": "/:slug/review"
    },
    {
      "source": "/:slug/book",
      "destination": "/:slug/book"
    },
    {
      "source": "/:slug((?!api|webhooks|_next|dashboard|login|bhuvanesh|admin|favicon).*)",
      "destination": "/dashboard"
    }
  ]
}
