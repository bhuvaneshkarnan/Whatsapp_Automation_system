# ============================================================
# WhatsApp Automation Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_platform
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://platform_user:CHANGE_ME@localhost:5432/whatsapp_platform

# --- Redis (handles dedup, sessions, rate limiting, message queue) ---
REDIS_URL=redis://localhost:6379

# --- JWT Auth ---
JWT_SECRET=CHANGE_ME_minimum_32_characters_long
JWT_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=604800

# --- Meta WhatsApp (Platform-level; per-tenant values stored encrypted in DB) ---
# These are fallback defaults for local development only.
# Each client stores their own: Phone Number ID + Access Token + WABA ID
META_GRAPH_API_VERSION=v19.0
META_APP_SECRET=CHANGE_ME          # Used to validate webhook HMAC signatures
META_VERIFY_TOKEN=CHANGE_ME        # Used for webhook subscription verification

# --- Per-client credentials (stored in tenant_credentials table, encrypted) ---
# Example structure for each tenant stored in DB:
#   whatsapp_phone_number_id  = "123456789012345"
#   whatsapp_access_token     = "EAAxxxxxx..."  (permanent system user token)
#   whatsapp_waba_id          = "987654321098765"
#   gemini_api_key            = "AIzaSy..."     (client's own Google AI Studio key)
#   google_calendar_creds     = "{token, refresh_token, client_id, ...}"

# --- AI: Gemini only (platform-level dev key; production = per-tenant from DB) ---
GEMINI_API_KEY=AIzaSy_CHANGE_ME
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=8000

# --- Google OAuth (for Calendar) ---
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:3008/api/v1/auth/google/callback

# --- Internal Service URLs ---
WEBHOOK_SERVICE_URL=http://localhost:3001
CORE_WORKER_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3004
CALENDAR_SYNC_URL=http://localhost:3005
CRM_API_URL=http://localhost:3007
AUTH_SERVICE_URL=http://localhost:3008

# --- S3 / MinIO (media attachments) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=whatsapp-platform
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Oracle Cloud / Server ---
# For Oracle Free Tier: set to your instance's public IP
PUBLIC_HOST=localhost
ENVIRONMENT=development
LOG_LEVEL=info
